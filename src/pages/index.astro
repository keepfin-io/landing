---
/*
  `/` picks the language. On Cloudflare Pages the function in functions/index.js answers first with a 302 (the
  `lang` cookie, else the browser's Accept-Language, else English); this page is the static fallback for other
  hosts and local preview: the language chosen before in the language menu (cookie or localStorage), else the
  first Turkish or English entry in the browser's languages, else English. Search engines read it as the
  hreflang x-default and find /tr/ and /en/ through hreflang and the sitemap.
*/
import SEO from '../components/SEO.astro';
import { fallbackLang, langPath, languages, type Lang } from '../i18n/ui';

const langs = Object.keys(languages) as Lang[];
const paths = Object.fromEntries(langs.map((code) => [code, langPath(code)]));
const fallback = langPath(fallbackLang);
---

<!doctype html>
<html lang={fallbackLang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<SEO
  title="Keepfin: open-source portfolio and finance tracker"
  description="Keepfin is an open-source portfolio and personal finance tracker. Açık kaynak portföy ve finans takip uygulaması."
  image={{ path: '/og/en.png', alt: 'Keepfin: open-source portfolio and finance tracking', width: 1200, height: 630 }}
/>
<script is:inline define:vars={{ paths, fallback }}>
  (() => {
    const known = Object.keys(paths);
    let saved = (document.cookie.match(/(?:^|;\s*)lang=([a-z]+)/) || [])[1] || null;
    if (!saved) try { saved = localStorage.getItem('lang'); } catch (_) {}
    const wanted = (navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''])
      .map((l) => String(l).toLowerCase().split('-')[0]);
    const pick = known.includes(saved) ? saved : wanted.find((l) => known.includes(l));
    location.replace((pick ? paths[pick] : fallback) + location.search + location.hash);
  })();
</script>
<noscript><meta http-equiv="refresh" content={`0;url=${fallback}`} /></noscript>
<style>
  html { background: #10171d; color: #e0eaed; font: 16px/1.5 system-ui, sans-serif; }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; }
  a { color: #4bb7bb; margin: 0 12px; }
</style>
</head>
<body>
  <p>
    {langs.map((code) => <a href={langPath(code)} hreflang={code} lang={code}>{languages[code].name}</a>)}
  </p>
</body>
</html>
